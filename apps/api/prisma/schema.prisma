generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

// ─── Identity ────────────────────────────────────────────────────────────────

model User {
  id              String    @id @default(uuid(7)) @db.Uuid
  email           String    @unique
  handle          String    @unique
  displayName     String
  passwordHash    String
  /// Storage key of the processed avatar; the api serves it at a stable URL (see users.mapper).
  avatarKey       String?
  pronouns        String?
  bio             String?
  statusEmoji     String?
  statusText      String?
  /// A custom status clears itself after this moment (null: until changed).
  statusExpiresAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  refreshTokens   RefreshToken[]
  ownedNooks      Nook[]          @relation("NookOwner")
  memberships     NookMember[]
  channelMembers  ChannelMember[]
  messages        Message[]
  reactions       Reaction[]
  attachments     Attachment[]
  mentions        Mention[]
  notifications   Notification[]  @relation("NotificationRecipient")
  actedOn         Notification[]  @relation("NotificationActor")
  invitesCreated  Invite[]
  channelsCreated Channel[]
}

/// Rotating refresh tokens. A reused (already rotated) token revokes its whole family.
model RefreshToken {
  id           String    @id @default(uuid(7)) @db.Uuid
  userId       String    @db.Uuid
  familyId     String    @db.Uuid
  tokenHash    String    @unique
  expiresAt    DateTime
  revokedAt    DateTime?
  replacedById String?   @db.Uuid
  userAgent    String?
  createdAt    DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
}

// ─── Nooks (communities) ─────────────────────────────────────────────────────

model Nook {
  id          String   @id @default(uuid(7)) @db.Uuid
  slug        String   @unique
  name        String
  description String?
  crestUrl    String?
  /// Kit colours: `kitField` owns the rail and header; `kitMark` is the single active marker.
  kitField    String
  kitMark     String
  ownerId     String   @db.Uuid
  createdAt   DateTime @default(now())

  owner    User         @relation("NookOwner", fields: [ownerId], references: [id])
  members  NookMember[]
  channels Channel[]
  invites  Invite[]
}

model NookMember {
  nookId   String   @db.Uuid
  userId   String   @db.Uuid
  joinedAt DateTime @default(now())

  nook Nook @relation(fields: [nookId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([nookId, userId])
  @@index([userId])
}

model Invite {
  code        String    @id
  nookId      String    @db.Uuid
  createdById String    @db.Uuid
  expiresAt   DateTime?
  maxUses     Int?
  uses        Int       @default(0)
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  nook      Nook @relation(fields: [nookId], references: [id], onDelete: Cascade)
  createdBy User @relation(fields: [createdById], references: [id])

  @@index([nookId])
}

// ─── Channels & messages ─────────────────────────────────────────────────────

enum ChannelKind {
  public
  private
  direct
}

model Channel {
  id          String      @id @default(uuid(7)) @db.Uuid
  nookId      String      @db.Uuid
  kind        ChannelKind
  /// Null for direct messages.
  name        String?
  topic       String?
  /// Sorted participant ids joined with ':' for direct channels, so a pair maps to one channel.
  directKey   String?     @unique
  createdById String?     @db.Uuid
  createdAt   DateTime    @default(now())

  nook      Nook            @relation(fields: [nookId], references: [id], onDelete: Cascade)
  createdBy User?           @relation(fields: [createdById], references: [id], onDelete: SetNull)
  members   ChannelMember[]
  messages  Message[]

  @@unique([nookId, name])
  @@index([nookId, kind])
}

model ChannelMember {
  channelId         String    @db.Uuid
  userId            String    @db.Uuid
  /// Unread = messages with id > lastReadMessageId (UUIDv7 ids sort by time).
  lastReadMessageId String?   @db.Uuid
  mutedAt           DateTime?
  joinedAt          DateTime  @default(now())

  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([channelId, userId])
  @@index([userId])
}

enum MessageKind {
  user
  system
}

model Message {
  /// UUIDv7, assigned by the server: time-ordered, so it doubles as the pagination cursor.
  id           String                   @id @default(uuid(7)) @db.Uuid
  channelId    String                   @db.Uuid
  authorId     String?                  @db.Uuid
  kind         MessageKind              @default(user)
  body         String
  threadRootId String?                  @db.Uuid
  replyCount   Int                      @default(0)
  lastReplyAt  DateTime?
  createdAt    DateTime                 @default(now())
  editedAt     DateTime?
  deletedAt    DateTime?
  /// The sender's own id for this message; (authorId, clientId) is unique, so retries never duplicate.
  clientId     String?                  @db.Uuid
  /// Generated column (see migration): to_tsvector('simple', body). Indexed with GIN.
  search       Unsupported("tsvector")? @default(dbgenerated("to_tsvector('simple'::regconfig, COALESCE(body, ''::text))"))

  channel       Channel        @relation(fields: [channelId], references: [id], onDelete: Cascade)
  author        User?          @relation(fields: [authorId], references: [id], onDelete: SetNull)
  threadRoot    Message?       @relation("Thread", fields: [threadRootId], references: [id], onDelete: Cascade)
  replies       Message[]      @relation("Thread")
  reactions     Reaction[]
  attachments   Attachment[]
  linkPreviews  LinkPreview[]
  mentions      Mention[]
  notifications Notification[]

  @@unique([authorId, clientId])
  @@index([channelId, id(sort: Desc)])
  @@index([threadRootId, id])
  @@index([authorId])
  @@index([search], map: "Message_search_idx", type: Gin)
}

model Reaction {
  messageId String   @db.Uuid
  userId    String   @db.Uuid
  emoji     String
  createdAt DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([messageId, userId, emoji])
}

enum AttachmentStatus {
  pending
  ready
  failed
}

model Attachment {
  id         String           @id @default(uuid(7)) @db.Uuid
  uploaderId String           @db.Uuid
  messageId  String?          @db.Uuid
  storageKey String           @unique
  thumbKey   String?
  fileName   String
  mimeType   String
  size       Int
  width      Int?
  height     Int?
  status     AttachmentStatus @default(pending)
  createdAt  DateTime         @default(now())

  uploader User     @relation(fields: [uploaderId], references: [id], onDelete: Cascade)
  message  Message? @relation(fields: [messageId], references: [id], onDelete: SetNull)

  @@index([messageId])
}

model LinkPreview {
  id          String   @id @default(uuid(7)) @db.Uuid
  messageId   String   @db.Uuid
  url         String
  title       String?
  description String?
  imageUrl    String?
  siteName    String?
  fetchedAt   DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([messageId, url])
}

model Mention {
  messageId String @db.Uuid
  userId    String @db.Uuid

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([messageId, userId])
  @@index([userId])
}

enum NotificationKind {
  mention
  reply
}

model Notification {
  id        String           @id @default(uuid(7)) @db.Uuid
  userId    String           @db.Uuid
  actorId   String?          @db.Uuid
  kind      NotificationKind
  messageId String?          @db.Uuid
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user    User     @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)
  actor   User?    @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)
  message Message? @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
}
